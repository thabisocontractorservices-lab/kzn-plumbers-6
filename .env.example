# Supabase public configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only Supabase credential. Never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key

# Canonical production URL
NEXT_PUBLIC_SITE_URL=https://www.kznplumbers.co.za

# Google Places API New server credential
GOOGLE_API_KEY=replace_with_restricted_google_api_key

# Vercel cron and protected maintenance endpoints
CRON_SECRET=replace_with_random_32_plus_character_secret

# Transactional email via Resend
RESEND_API_KEY=replace_with_resend_api_key
ADMIN_EMAIL=thabiso@kznplumbers.co.za
FROM_EMAIL="KZN Plumbers <admin@kznplumbers.co.za>"

# Optional Google Analytics 4 measurement ID
# Analytics only loads after the visitor grants consent.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX


# Optional override: comma-separated existing administrator emails.
# Users must STILL have confirmed accounts and profiles.role=admin.
# Omit to retain the existing owner/admin identities from the handoff.
# ADMIN_ALLOWED_EMAILS=owner@example.com

# Optional GA privacy switch. Leave false unless the existing stream has automatic
# Enhanced Measurement/search/form/outbound-link collection disabled.
# The website works without Google Analytics or an additional Supabase table.
GA_AUTOMATIC_MEASUREMENT_DISABLED=false
