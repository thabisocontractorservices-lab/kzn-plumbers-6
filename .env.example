# Supabase public configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only Supabase credential. Never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key

# Canonical production URL
NEXT_PUBLIC_SITE_URL=https://www.kznplumbers.co.za

# Google Places API New server credential
GOOGLE_API_KEY=replace_with_restricted_google_api_key

# Vercel cron and protected maintenance endpoints
CRON_SECRET=replace_with_random_32_plus_character_secret

# Transactional email via Resend
RESEND_API_KEY=replace_with_resend_api_key
ADMIN_EMAIL=thabiso@kznplumbers.co.za
FROM_EMAIL="KZN Plumbers <admin@kznplumbers.co.za>"

# Optional Google Analytics 4 measurement ID
# Analytics only loads after the visitor grants consent.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
